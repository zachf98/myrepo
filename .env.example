# Listing source credentials. None of the natural capital datasets need a key;
# only the listing feed does. Copy to .env and fill in whichever you obtain.

# --- Zillow Group / Bridge Interactive -------------------------------------
# The sanctioned route to Zillow-affiliated listing data. Apply at
# https://bridgedataoutput.com, get an MLS to approve the dataset, then set the
# server token and the dataset name they assign you.
BRIDGE_API_TOKEN=
BRIDGE_DATASET=

# --- Generic RESO Web API --------------------------------------------------
# Works with most MLS and aggregator feeds, which is usually easier to get than
# a Zillow-affiliated dataset. Base URL should end before /Property.
RESO_BASE_URL=
RESO_ACCESS_TOKEN=

# Optional: override the scoring config path.
# NCSCOUT_CONFIG=config/scoring.yaml
